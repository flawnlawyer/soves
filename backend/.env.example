# Sōvēs Backend Environment Variables
# Copy this to .env and fill in your values

# App
DEBUG=false

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here

# Database
# SQLite (default, no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./soves.db
# PostgreSQL (Supabase):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/soves

# CORS — add your frontend URL
ALLOWED_ORIGINS=["http://localhost:5173"]

# Storage
DEFAULT_STORAGE_ADAPTER=local
LOCAL_STORAGE_PATH=./storage_data
MAX_FILE_SIZE_MB=100

# S3-compatible (leave empty to use local storage)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=soves
S3_REGION=auto
